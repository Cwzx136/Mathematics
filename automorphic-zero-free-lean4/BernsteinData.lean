import BernsteinCore

/-! The coefficient table uses the numerator of the normalized amplifier.
For integer `j`, the local variable of U_j is half the trace. -/
namespace EllipticBernstein

def amplifier (x y : ℝ) : ℝ :=
  462244 * ((1) * x^0) * ((1) * y^0) +
  444674 * ((4) * x^2 + (-1) * x^0) * ((1) * y^0) +
  47038 * ((16) * x^4 + (-12) * x^2 + (1) * x^0) * ((1) * y^0) +
  1191 * ((64) * x^6 + (-80) * x^4 + (24) * x^2 + (-1) * x^0) * ((1) * y^0) +
  1000000 * ((2) * x^1) * ((1) * y^1) +
  293292 * ((8) * x^3 + (-4) * x^1) * ((1) * y^1) +
  433762 * ((1) * x^0) * ((2) * y^2 + (-1) * y^0) +
  343537 * ((4) * x^2 + (-1) * x^0) * ((2) * y^2 + (-1) * y^0) +
  348 * ((64) * x^6 + (-80) * x^4 + (24) * x^2 + (-1) * x^0) * ((2) * y^2 + (-1) * y^0) +
  179116 * ((2) * x^1) * ((4) * y^3 + (-3) * y^1) +
  1183 * ((8) * x^3 + (-4) * x^1) * ((4) * y^3 + (-3) * y^1) +
  33882 * ((1) * x^0) * ((8) * y^4 + (-8) * y^2 + (1) * y^0) +
  31 * ((64) * x^6 + (-80) * x^4 + (24) * x^2 + (-1) * x^0) * ((8) * y^4 + (-8) * y^2 + (1) * y^0) +
  439 * ((1) * x^0) * ((32) * y^6 + (-48) * y^4 + (18) * y^2 + (-1) * y^0) +
  110 * ((4) * x^2 + (-1) * x^0) * ((32) * y^6 + (-48) * y^4 + (18) * y^2 + (-1) * y^0)

def interiorNet : Net :=
  ⟨⟨7077600, 16704904, 12619064, 1878928, 487440, 30696, 5336⟩, ⟨9242280, (-8953744), (-55699080), (-54488416), (-12416360), (-1476368), (-200376)⟩, ⟨(-99976), (-46294696), (-53818496), 35861104, 69141816, 18682680, 2231504⟩, ⟨(-6258160), (-23564128), 45697520, 116135616, 45697520, (-23564128), (-6258160)⟩, ⟨2231504, 18682680, 69141816, 35861104, (-53818496), (-46294696), (-99976)⟩, ⟨(-200376), (-1476368), (-12416360), (-54488416), (-55699080), (-8953744), 9242280⟩, ⟨5336, 30696, 487440, 1878928, 12619064, 16704904, 7077600⟩⟩

def exteriorNet : Net :=
  ⟨⟨5336, 30696, 487440, 1878928, 12619064, 16704904, 7077600⟩, ⟨116196, 830272, 7670500, 32880992, 65706732, 54591584, 16611660⟩, ⟨828356, 6631240, 34633804, 84121776, 103490716, 62261896, 14963156⟩, ⟨2161832, 14209056, 45597768, 76221440, 68550072, 32752608, 6873432⟩, ⟨2134208, 9482368, 22213440, 29730560, 22213440, 9482368, 2134208⟩, ⟨602880, 2167296, 4766976, 6405120, 4766976, 2167296, 602880⟩, ⟨100480, 361216, 794496, 1067520, 794496, 361216, 100480⟩⟩

theorem interior_identity (x y : ℝ) :
    netValue interiorNet (x+1) (1-x) (y+1) (1-y) = 4096 * (amplifier x y - 2) := by
  norm_num [interiorNet, netValue, rowValue, map7, value, amplifier]; ring

theorem exterior_identity (x y : ℝ) :
    netValue exteriorNet (x-1) 1 (y+1) (1-y) = 64 * (amplifier x y - 2) := by
  norm_num [exteriorNet, netValue, rowValue, map7, value, amplifier]; ring

theorem amplifier_reflect (x y : ℝ) : amplifier (-x) (-y) = amplifier x y := by
  unfold amplifier; ring

theorem exterior_good : netGood exteriorNet := by decide +kernel

end EllipticBernstein
