set_option maxHeartbeats 2000000 in
theorem interior_identity (x y : ℝ) :
    Octic.netValue interior (x+1) (1-x) (y+1) (1-y) = 65536*polynomial x y := by
  norm_num [interior, Octic.netValue, Octic.rowValue, Octic.map9, Octic.value, polynomial, evalTable, posTable, negTable, chebU, chebT]
  ring

theorem interior_nonnegative (x y : ℝ) (hx0 : -1 ≤ x) (hx1 : x ≤ 1)
    (hy0 : -1 ≤ y) (hy1 : y ≤ 1) : 0 ≤ polynomial x y := by
  have hp : Octic.positiveOn interior := hp
  have h := hp (x+1) (1-x) (y+1) (1-y)
    (by linarith) (by linarith) (by linarith) (by linarith)
  rw [interior_identity] at h
  linarith

def pole : ℚ := ((weightAt 0 0 posTable : ℚ)-weightAt 0 0 negTable) / weightAt 1 1 posTable
def slope : ℚ := (Weyl.sumCost posTable - Weyl.sumCost negTable) / weightAt 1 1 posTable
theorem target_and_pole : weightAt 1 1 posTable = 1000000 ∧ weightAt 1 1 negTable = 0 ∧ pole = 306229/500000 := by decide +kernel
theorem exact_cost : slope = 82457203/186000000 := by decide +kernel
theorem moving_power_restriction :
    posTable.all (fun e => decide (e.1 = 0 ∨ e.2.1 ≤ 2)) = true := by decide +kernel

theorem normalized_fourier_nonnegative (x θ : ℝ) (h0 : -1 ≤ x) (h1 : x ≤ 1) :
    0 ≤ (evalFourier x θ posTable - evalFourier x θ negTable)/1000000 := by
  simp only [fourier_eq]
  exact div_nonneg (interior_nonnegative x _ h0 h1 (Real.neg_one_le_cos _) (Real.cos_le_one _)) (by norm_num)

#print axioms normalized_fourier_nonnegative
#print axioms moving_power_restriction
#print axioms exact_cost
end EllipticBernstein.TiltedOctic
